# ============================================================
# TurboTube configuration — copy to .env and edit as needed.
# Every setting can also be supplied as an environment variable.
# ============================================================

# --- server -------------------------------------------------
TT_HOST=127.0.0.1
TT_PORT=8000
TT_LOG_LEVEL=info

# Optional shared secret. When set, every /api request needs
# `X-API-Key: <value>` (the web UI prompts for it). Keep empty
# when the server only listens on localhost.
TT_API_KEY=

# Comma-separated origins if you embed the API in another site.
TT_CORS_ORIGINS=

# --- storage ------------------------------------------------
TT_DOWNLOAD_DIR=downloads
TT_DATA_DIR=data

# --- performance --------------------------------------------
# How many videos are downloaded at the same time.
TT_MAX_CONCURRENT_DOWNLOADS=4
# Parallel byte-range requests per video (DASH fragments).
TT_FRAGMENTS_PER_DOWNLOAD=16
# HTTP chunk size in MiB when the native downloader is used.
TT_HTTP_CHUNK_SIZE_MB=10
# aria2c is auto-detected; set false to always use yt-dlp native.
TT_USE_ARIA2=true
# Connections per video when aria2c is active.
TT_ARIA2_CONNECTIONS=16
# Retries for transient network failures.
TT_RETRIES=3
TT_SOCKET_TIMEOUT=20

# --- behaviour ----------------------------------------------
# Seconds to cache URL analysis (0 disables).
TT_PROBE_CACHE_TTL=180
# Maximum playlist entries returned by /api/probe.
TT_PROBE_MAX_ENTRIES=1000
# Job history kept in SQLite and in memory.
TT_MAX_HISTORY=200
# Enable the "open download folder" button.
TT_ENABLE_OPEN_FOLDER=true
# Re-queue jobs interrupted by a restart.
TT_AUTO_RESUME=false

# --- safety -------------------------------------------------
# Comma-separated allowlist, e.g. youtube.com,youtu.be,vimeo.com
# Empty means "any public host".
TT_ALLOWED_HOSTS=
# Allow private/loopback targets (needed only for local test media).
TT_ALLOW_PRIVATE_HOSTS=false
